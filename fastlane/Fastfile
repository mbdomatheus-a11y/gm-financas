# Build iOS e envio ao TestFlight, rodando no Mac do GitHub Actions.
# A chave da API vem dos Secrets ASC_KEY_ID, ASC_ISSUER_ID e ASC_KEY_P8.

BUNDLE_ID = "co.median.ios.nmlbjjq"
TEAM_ID = "WG63N9W37M"
PERFIL = "Control ALL Finanças AppStore"
CERT_ID = "MBK6W266SF"

default_platform(:ios)

platform :ios do
  desc "Compila o app e envia ao TestFlight"
  lane :enviar_testflight do
    api = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
      in_house: false
    )

    # Salvar senha nas Senhas do iPhone: o App ID precisa da capacidade Associated Domains
    # (idempotente: só liga se ainda não estiver ligada). O perfil gerado abaixo já a inclui.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api)
    bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
    tipos = bundle.get_capabilities.map(&:capability_type)
    unless tipos.include?(Spaceship::ConnectAPI::BundleIdCapability::Type::ASSOCIATED_DOMAINS)
      UI.message("Ligando Associated Domains no App ID #{BUNDLE_ID}")
      bundle.update_capability(Spaceship::ConnectAPI::BundleIdCapability::Type::ASSOCIATED_DOMAINS, enabled: true)
    end

    # Perfil de App Store usando o certificado já importado do Secret CERT_P12_BASE64.
    sigh(
      api_key: api,
      app_identifier: BUNDLE_ID,
      adhoc: false,
      provisioning_name: PERFIL,
      cert_id: CERT_ID,
      force: true
    )

    # O sigh pode criar o perfil com outro nome (sufixo); usa o nome real.
    perfil = lane_context[SharedValues::SIGH_NAME] || PERFIL

    # Versão do app (ex.: 1.1.0) vem de ios/VERSAO; o build é o número da execução do CI.
    versao = File.read(File.expand_path("../ios/VERSAO", __dir__)).strip
    UI.message("Control ALL iOS: versão #{versao} (build #{ENV['GITHUB_RUN_NUMBER'] || '1'})")

    # Assinatura manual só no target App (os Pods não aceitam perfil manual).
    require "xcodeproj"
    proj = Xcodeproj::Project.open(File.expand_path("../ios/App/App.xcodeproj", __dir__))
    app_target = proj.targets.find { |t| t.name == "App" }
    app_target.build_configurations.each do |c|
      c.build_settings["DEVELOPMENT_TEAM"] = TEAM_ID
      c.build_settings["CODE_SIGN_STYLE"] = "Manual"
      c.build_settings["CODE_SIGN_IDENTITY"] = "Apple Distribution"
      c.build_settings["PROVISIONING_PROFILE_SPECIFIER"] = perfil
      c.build_settings["CURRENT_PROJECT_VERSION"] = ENV["GITHUB_RUN_NUMBER"] || "1"
      c.build_settings["MARKETING_VERSION"] = versao
      c.build_settings["CODE_SIGN_ENTITLEMENTS"] = "App/App.entitlements"
    end
    proj.save

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: { BUNDLE_ID => perfil }
      }
    )

    # Notas desta versão aparecem no TestFlight, em "O que testar".
    notas = File.read(File.expand_path("notas-da-versao.txt", __dir__)).strip
    upload_to_testflight(
      api_key: api,
      skip_waiting_for_build_processing: false,
      wait_processing_timeout_duration: 2400,
      distribute_external: false,
      localized_build_info: {
        "default" => { whats_new: notas },
        "pt-BR" => { whats_new: notas }
      }
    )
  end
end
